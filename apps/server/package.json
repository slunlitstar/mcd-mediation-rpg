{
  "name": "@mcd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "mcp:probe": "tsx --env-file-if-exists=../../.env src/mcp/probe.ts",
    "mcp:shapes": "tsx --env-file-if-exists=../../.env src/mcp/probe-data.ts",
    "mcp:fixtures": "tsx --env-file-if-exists=../../.env src/mcp/snapshot-fixtures.ts",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/smoke.ts",
    "test": "node --import tsx --test src/services/plan.test.ts src/services/mediate.test.ts src/services/ai.test.ts src/services/mediate.model.test.ts src/mcp/default-combo.test.ts src/services/shared-meals.test.ts",
    "ai:probe": "tsx --env-file-if-exists=../../.env scripts/ai-probe.ts",
    "mcp:order": "tsx --env-file-if-exists=../../.env src/mcp/probe-order.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node build-package.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0"
  }
}
