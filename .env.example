# Copy to .env in the repository root. Never commit .env.
# VITE_* values are public browser configuration; never put secrets here.
VITE_API_BASE_URL=/api

# Local Node.js server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# McDonald's MCP (server-only; read by apps/server, never expose to the browser).
# Token: https://open.mcd.cn/mcp -> 登录 -> 控制台 -> 激活 -> 复制
MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=

# LLM (server-only). 三项必须同时填写才算配置；只填 AI_API_KEY 不算接入。
# AI_BASE_URL 接受 https://host/v1，程序会自动补 /chat/completions。
# 模型只负责「选哪些商品」，金额一律由 calculate-price 重算。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 单次模型请求超时（毫秒），不填默认 20000；网关慢可调到 60000。
AI_TIMEOUT_MS=
