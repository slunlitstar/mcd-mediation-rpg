# Copy to .env in the repository root. Never commit .env.
# VITE_* values are public browser configuration; never put secrets here.
VITE_API_BASE_URL=/api

# Local Node.js server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# McDonald's MCP (server-only; read by apps/server, never expose to the browser).
# Token: https://open.mcd.cn/mcp -> 登录 -> 控制台 -> 激活 -> 复制
MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
