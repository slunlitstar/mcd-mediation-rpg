# Copy to .env in the repository root. Never commit .env.
# VITE_* values are public browser configuration; never put secrets here.
VITE_API_BASE_URL=/api

# Local Node.js server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Reserved for future server-only integrations; not used by this scaffold.
MCD_MCP_URL=
MCD_MCP_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
